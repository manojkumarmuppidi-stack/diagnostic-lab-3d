// AED Hospital — Financial, Accounting & Operational Analytics System
// See DATABASE_SCHEMA.md for the narrative description of every entity.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

/// Lifecycle of every financial row. Only ACTIVE rows are counted anywhere.
enum RecordStatus {
  ACTIVE
  SUPERSEDED // replaced by a correction (see correctionOfId on the new row)
  VOIDED // soft-deleted with a reason
  REVERSED // its import batch was reversed
}

enum VisitType {
  NEW
  OLD
}

enum StaffKind {
  DOCTOR
  DIETICIAN
  OTHER
}

enum ExpenseGroup {
  HOSPITAL // hospital operating expense
  OTHER // other (non-operating / miscellaneous) expense
}

/// Buckets used by reconciliation. Each PaymentMode maps to one.
enum ReconGroup {
  CASH
  CARD
  UPI
  BANK
  OTHER
}

enum DayStatus {
  OPEN
  REVIEW
  RECONCILED
  CLOSED
}

enum IpdTxnType {
  ADVANCE
  PAYMENT
  FINAL_SETTLEMENT
  REFUND
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ImportStatus {
  UPLOADED
  VALIDATED
  IMPORTED
  CANCELLED
  REVERSED
}

enum ImportRowStatus {
  PENDING
  VALID
  WARNING
  INVALID
  DUPLICATE
  IMPORTED
  SKIPPED
  REVERSED
}

// ─────────────────────────── Security ───────────────────────────

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String
  group       String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  name               String
  email              String?
  passwordHash       String
  roleId             String
  role               Role      @relation(fields: [roleId], references: [id])
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sessions           Session[]
}

model Session {
  /// SHA-256 of the random session token (the raw token only lives in the cookie).
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
}

// ─────────────────────────── Master data ───────────────────────────

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctors         Doctor[]
  investigations  LabInvestigation[]
  labTransactions LabTransaction[]
  expenses        Expense[]
}

model Specialty {
  id            String         @id @default(cuid())
  name          String         @unique
  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  doctors       Doctor[]
  consultations Consultation[]
}

/// Doctors, dieticians and other billing staff.
model Doctor {
  id           String      @id @default(cuid())
  name         String
  kind         StaffKind   @default(DOCTOR)
  specialtyId  String?
  specialty    Specialty?  @relation(fields: [specialtyId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  consultations   Consultation[]
  admissions      IpdAdmission[]
  labReferrals    LabTransaction[]
  dietServices    DietTransaction[]

  @@unique([name, kind])
}

model ConsultationType {
  id            String         @id @default(cuid())
  name          String         @unique
  defaultRate   Decimal        @default(0) @db.Decimal(12, 2)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  consultations Consultation[]
}

/// Long Admission, Short Admission, Sugar Control Plan, Other …
model AdmissionType {
  id         String         @id @default(cuid())
  name       String         @unique
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  packages   IpdPackage[]
  admissions IpdAdmission[]
}

model IpdPackage {
  id              String         @id @default(cuid())
  name            String         @unique
  admissionTypeId String?
  admissionType   AdmissionType? @relation(fields: [admissionTypeId], references: [id])
  rate            Decimal        @default(0) @db.Decimal(12, 2)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  admissions      IpdAdmission[]
}

model LabInvestigation {
  id           String           @id @default(cuid())
  name         String           @unique
  code         String?
  category     String           @default("General")
  rate         Decimal          @default(0) @db.Decimal(12, 2)
  departmentId String?
  department   Department?      @relation(fields: [departmentId], references: [id])
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  transactions LabTransaction[]
}

model DietService {
  id           String            @id @default(cuid())
  name         String            @unique
  rate         Decimal           @default(0) @db.Decimal(12, 2)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  transactions DietTransaction[]
}

/// Two-level tree: parentId = null → category, otherwise → subcategory.
model ExpenseCategory {
  id        String            @id @default(cuid())
  name      String
  group     ExpenseGroup      @default(HOSPITAL)
  parentId  String?
  parent    ExpenseCategory?  @relation("ExpenseCategoryTree", fields: [parentId], references: [id])
  children  ExpenseCategory[] @relation("ExpenseCategoryTree")
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  expenses          Expense[] @relation("ExpenseCategory")
  subcategoryExpenses Expense[] @relation("ExpenseSubcategory")

  @@unique([name, parentId])
}

model PaymentMode {
  id         String     @id @default(cuid())
  code       String     @unique
  name       String
  reconGroup ReconGroup
  active     Boolean    @default(true)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  consultations     Consultation[]
  ipdTransactions   IpdTransaction[]
  labTransactions   LabTransaction[]
  pharmacySales     PharmacySale[]
  pharmacyPurchases PharmacyPurchase[]
  pharmacyReturns   PharmacyReturn[]
  dietTransactions  DietTransaction[]
  otherIncomes      OtherIncome[]
  expenses          Expense[]
}

/// Minimal patient identity for billing only. No clinical data is stored.
model Patient {
  id          String   @id @default(cuid())
  patientCode String   @unique
  name        String
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  consultations    Consultation[]
  admissions       IpdAdmission[]
  labTransactions  LabTransaction[]
  pharmacySales    PharmacySale[]
  dietTransactions DietTransaction[]
}

// ─────────────────────────── Income ───────────────────────────
// Every financial table shares: status, fingerprint (duplicate key), importBatchId,
// correctionOfId (the row this one corrects), voidReason, createdById, timestamps.

model Consultation {
  id                 String            @id @default(cuid())
  date               DateTime          @db.Date
  patientId          String?
  patient            Patient?          @relation(fields: [patientId], references: [id])
  patientName        String?
  doctorId           String?
  doctor             Doctor?           @relation(fields: [doctorId], references: [id])
  specialtyId        String?
  specialty          Specialty?        @relation(fields: [specialtyId], references: [id])
  consultationTypeId String?
  consultationType   ConsultationType? @relation(fields: [consultationTypeId], references: [id])
  visitType          VisitType
  grossAmount        Decimal           @db.Decimal(12, 2)
  discount           Decimal           @default(0) @db.Decimal(12, 2)
  netAmount          Decimal           @db.Decimal(12, 2)
  paymentModeId      String?
  paymentMode        PaymentMode?      @relation(fields: [paymentModeId], references: [id])
  reference          String?
  remarks            String?

  status         RecordStatus @default(ACTIVE)
  fingerprint    String
  importBatchId  String?
  importBatch    ImportBatch? @relation(fields: [importBatchId], references: [id])
  correctionOfId String?      @unique
  voidReason     String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([date, status])
  @@index([fingerprint])
  @@index([importBatchId])
  @@index([patientId])
}

model IpdAdmission {
  id              String         @id @default(cuid())
  admissionDate   DateTime       @db.Date
  dischargeDate   DateTime?      @db.Date
  patientId       String?
  patient         Patient?       @relation(fields: [patientId], references: [id])
  patientName     String?
  admissionTypeId String
  admissionType   AdmissionType  @relation(fields: [admissionTypeId], references: [id])
  doctorId        String?
  doctor          Doctor?        @relation(fields: [doctorId], references: [id])
  packageId       String?
  package         IpdPackage?    @relation(fields: [packageId], references: [id])
  /// Billed value of the admission (accrual view). Income is recognised from IpdTransaction.
  grossAmount     Decimal        @db.Decimal(12, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  netAmount       Decimal        @db.Decimal(12, 2)
  reference       String?
  remarks         String?
  transactions    IpdTransaction[]

  status         RecordStatus @default(ACTIVE)
  fingerprint    String
  importBatchId  String?
  importBatch    ImportBatch? @relation(fields: [importBatchId], references: [id])
  correctionOfId String?      @unique
  voidReason     String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([admissionDate, status])
  @@index([fingerprint])
  @@index([importBatchId])
  @@index([patientId])
}

/// Money movements against an admission: advances, part payments, final settlement, refunds.
model IpdTransaction {
  id            String       @id @default(cuid())
  admissionId   String
  admission     IpdAdmission @relation(fields: [admissionId], references: [id])
  date          DateTime     @db.Date
  type          IpdTxnType
  /// Always positive; REFUND is subtracted by the accounting views.
  amount        Decimal      @db.Decimal(12, 2)
  paymentModeId String?
  paymentMode   PaymentMode? @relation(fields: [paymentModeId], references: [id])
  reference     String?
  remarks       String?

  status         RecordStatus @default(ACTIVE)
  fingerprint    String
  importBatchId  String?
  importBatch    ImportBatch? @relation(fields: [importBatchId], references: [id])
  correctionOfId String?      @unique
  voidReason     String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([date, status])
  @@index([admissionId])
  @@index([fingerprint])
  @@index([importBatchId])
}

model LabTransaction {
  id                String           @id @default(cuid())
  date              DateTime         @db.Date
  patientId         String?
  patient           Patient?         @relation(fields: [patientId], references: [id])
  patientName       String?
  investigationId   String
  investigation     LabInvestigation @relation(fields: [investigationId], references: [id])
  quantity          Int              @default(1)
  rate              Decimal          @db.Decimal(12, 2)
  grossAmount       Decimal          @db.Decimal(12, 2)
  discount          Decimal          @default(0) @db.Decimal(12, 2)
  netAmount         Decimal          @db.Decimal(12, 2)
  paymentModeId     String?
  paymentMode       PaymentMode?     @relation(fields: [paymentModeId], references: [id])
  referringDoctorId String?
  referringDoctor   Doctor?          @relation(fields: [referringDoctorId], references: [id])
  departmentId      String?
  department        Department?      @relation(fields: [departmentId], references: [id])
  reference         String?
  remarks           String?

  status         RecordStatus @default(ACTIVE)
  fingerprint    String
  importBatchId  String?
  importBatch    ImportBatch? @relation(fields: [importBatchId], references: [id])
  correctionOfId String?      @unique
  voidReason     String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([date, status])
  @@index([investigationId])
  @@index([fingerprint])
  @@index([importBatchId])
  @@index([patientId])
}

model PharmacySale {
  id            String       @id @default(cuid())
  date          DateTime     @db.Date
  invoiceNo     String?
  patientId     String?
  patient       Patient?     @relation(fields: [patientId], references: [id])
  patientName   String?
  grossAmount   Decimal      @db.Decimal(12, 2)
  discount      Decimal      @default(0) @db.Decimal(12, 2)
  netAmount     Decimal      @db.Decimal(12, 2)
  paymentModeId String?
  paymentMode   PaymentMode? @relation(fields: [paymentModeId], references: [id])
  remarks       String?

  status         RecordStatus @default(ACTIVE)
  fingerprint    String
  importBatchId  String?
  importBatch    ImportBatch? @relation(fields: [importBatchId], references: [id])
  correctionOfId String?      @unique
  voidReason     String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([date, status])
  @@index([invoiceNo])
  @@index([fingerprint])
  @@index([importBatchId])
}

model PharmacyReturn {
  id            String       @id @default(cuid())
  date          DateTime     @db.Date
  invoiceNo     String?
  amount        Decimal      @db.Decimal(12, 2)
  paymentModeId String?
  paymentMode   PaymentMode? @relation(fields: [paymentModeId], references: [id])
  reason        String?

  status         RecordStatus @default(ACTIVE)
  fingerprint    String
  importBatchId  String?
  importBatch    ImportBatch? @relation(fields: [importBatchId], references: [id])
  correctionOfId String?      @unique
  voidReason     String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([date, status])
  @@index([fingerprint])
  @@index([importBatchId])
}

model PharmacyPurchase {
  id            String       @id @default(cuid())
  date          DateTime     @db.Date
  supplier      String
  invoiceNo     String?
  amount        Decimal      @db.Decimal(12, 2)
  paymentModeId String?
  paymentMode   PaymentMode? @relation(fields: [paymentModeId], references: [id])
  remarks       String?

  status         RecordStatus @default(ACTIVE)
  fingerprint    String
  importBatchId  String?
  importBatch    ImportBatch? @relation(fields: [importBatchId], references: [id])
  correctionOfId String?      @unique
  voidReason     String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([date, status])
  @@index([fingerprint])
  @@index([importBatchId])
}

model DietTransaction {
  id            String       @id @default(cuid())
  date          DateTime     @db.Date
  patientId     String?
  patient       Patient?     @relation(fields: [patientId], references: [id])
  patientName   String?
  serviceId     String?
  service       DietService? @relation(fields: [serviceId], references: [id])
  dieticianId   String?
  dietician     Doctor?      @relation(fields: [dieticianId], references: [id])
  grossAmount   Decimal      @db.Decimal(12, 2)
  discount      Decimal      @default(0) @db.Decimal(12, 2)
  netAmount     Decimal      @db.Decimal(12, 2)
  paymentModeId String?
  paymentMode   PaymentMode? @relation(fields: [paymentModeId], references: [id])
  reference     String?
  remarks       String?

  status         RecordStatus @default(ACTIVE)
  fingerprint    String
  importBatchId  String?
  importBatch    ImportBatch? @relation(fields: [importBatchId], references: [id])
  correctionOfId String?      @unique
  voidReason     String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([date, status])
  @@index([fingerprint])
  @@index([importBatchId])
}

model OtherIncome {
  id            String       @id @default(cuid())
  date          DateTime     @db.Date
  source        String
  description   String?
  amount        Decimal      @db.Decimal(12, 2)
  paymentModeId String?
  paymentMode   PaymentMode? @relation(fields: [paymentModeId], references: [id])
  reference     String?

  status         RecordStatus @default(ACTIVE)
  fingerprint    String
  importBatchId  String?
  importBatch    ImportBatch? @relation(fields: [importBatchId], references: [id])
  correctionOfId String?      @unique
  voidReason     String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([date, status])
  @@index([fingerprint])
  @@index([importBatchId])
}

// ─────────────────────────── Expenditure ───────────────────────────

model Expense {
  id            String           @id @default(cuid())
  date          DateTime         @db.Date
  departmentId  String?
  department    Department?      @relation(fields: [departmentId], references: [id])
  categoryId    String
  category      ExpenseCategory  @relation("ExpenseCategory", fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   ExpenseCategory? @relation("ExpenseSubcategory", fields: [subcategoryId], references: [id])
  description   String
  vendor        String?
  billNumber    String?
  amount        Decimal          @db.Decimal(12, 2)
  paymentModeId String?
  paymentMode   PaymentMode?     @relation(fields: [paymentModeId], references: [id])
  remarks       String?
  attachments   Attachment[]

  status         RecordStatus @default(ACTIVE)
  fingerprint    String
  importBatchId  String?
  importBatch    ImportBatch? @relation(fields: [importBatchId], references: [id])
  correctionOfId String?      @unique
  voidReason     String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([date, status])
  @@index([categoryId])
  @@index([fingerprint])
  @@index([importBatchId])
}

model Attachment {
  id           String   @id @default(cuid())
  expenseId    String
  expense      Expense  @relation(fields: [expenseId], references: [id])
  fileName     String
  mimeType     String
  size         Int
  storageKey   String   @unique
  sha256       String
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([expenseId])
}

// ─────────────────────── Daily accounts & controls ───────────────────────

/// One row per business date once any closing action has happened. Missing row ⇒ OPEN.
model DailyAccount {
  id             String    @id @default(cuid())
  date           DateTime  @unique @db.Date
  status         DayStatus @default(OPEN)
  reviewedById   String?
  reviewedAt     DateTime?
  reconciledById String?
  reconciledAt   DateTime?
  closedById     String?
  closedAt       DateTime?
  reopenCount    Int       @default(0)
  notes          String?
  /// Totals frozen at close time, so later drift can be detected.
  closingSnapshot Json?
  updatedAt      DateTime  @updatedAt
  events         DayEvent[]
  reconciliations Reconciliation[]
}

model DayEvent {
  id             String       @id @default(cuid())
  dailyAccountId String
  dailyAccount   DailyAccount @relation(fields: [dailyAccountId], references: [id])
  fromStatus     DayStatus
  toStatus       DayStatus
  action         String
  reason         String?
  userId         String?
  createdAt      DateTime     @default(now())

  @@index([dailyAccountId, createdAt])
}

model Reconciliation {
  id             String       @id @default(cuid())
  dailyAccountId String
  dailyAccount   DailyAccount @relation(fields: [dailyAccountId], references: [id])
  reconGroup     ReconGroup
  expected       Decimal      @db.Decimal(12, 2)
  actual         Decimal      @db.Decimal(12, 2)
  variance       Decimal      @db.Decimal(12, 2)
  explanation    String?
  userId         String
  updatedAt      DateTime     @updatedAt

  @@unique([dailyAccountId, reconGroup])
}

model CorrectionRequest {
  id             String           @id @default(cuid())
  module         String
  entityId       String
  proposed       Json
  reason         String
  status         CorrectionStatus @default(PENDING)
  requestedById  String
  requestedAt    DateTime         @default(now())
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  resultEntityId String?

  @@index([status, requestedAt])
  @@index([module, entityId])
}

// ─────────────────────────── Import ───────────────────────────

model ImportBatch {
  id           String        @id @default(cuid())
  groupId      String?
  fileName     String
  fileHash     String
  sheetName    String?
  module       String
  status       ImportStatus  @default(UPLOADED)
  headers      Json
  mapping      Json?
  options      Json?
  recordsFound Int           @default(0)
  validRows    Int           @default(0)
  warningRows  Int           @default(0)
  invalidRows  Int           @default(0)
  duplicateRows Int          @default(0)
  imported     Int           @default(0)
  rejected     Int           @default(0)
  totalAmount  Decimal       @default(0) @db.Decimal(14, 2)
  uploadedById String
  createdAt    DateTime      @default(now())
  validatedAt  DateTime?
  committedAt  DateTime?
  reversedAt   DateTime?
  reversedById String?
  reverseReason String?
  records      ImportRecord[]

  consultations     Consultation[]
  admissions        IpdAdmission[]
  ipdTransactions   IpdTransaction[]
  labTransactions   LabTransaction[]
  pharmacySales     PharmacySale[]
  pharmacyReturns   PharmacyReturn[]
  pharmacyPurchases PharmacyPurchase[]
  dietTransactions  DietTransaction[]
  otherIncomes      OtherIncome[]
  expenses          Expense[]

  @@index([createdAt])
  @@index([fileHash])
}

model ImportRecord {
  id          String          @id @default(cuid())
  batchId     String
  batch       ImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber   Int
  raw         Json
  normalized  Json?
  status      ImportRowStatus @default(PENDING)
  errors      Json?
  warnings    Json?
  fingerprint String?
  duplicateOf String?
  /// Admin decision for duplicate rows: true → import anyway.
  forceImport Boolean         @default(false)
  entityIds   Json?

  @@index([batchId, status])
  @@index([batchId, rowNumber])
}

// ─────────────────────────── Audit & settings ───────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model Setting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}
