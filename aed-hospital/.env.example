# ---- Database (PostgreSQL 14+) ----
# Own server: both URLs are the same direct connection.
# Vercel/serverless: DATABASE_URL = POOLED url + &pgbouncer=true ; DIRECT_URL = direct url (migrations). See VERCEL.md.
DATABASE_URL="postgresql://aed:CHANGE_ME@localhost:5432/aed_hospital?schema=public"
DIRECT_URL="postgresql://aed:CHANGE_ME@localhost:5432/aed_hospital?schema=public"

# ---- Sessions ----
# Session lifetime in hours (default 12). Cookies are httpOnly, SameSite=Lax, Secure in production.
SESSION_TTL_HOURS=12
# Set to "true" only when serving over HTTPS (production). Leave false for http://localhost.
COOKIE_SECURE=false

# ---- Seed ----
# Initial admin password used by `npm run db:seed`. The admin must change it on first login.
SEED_ADMIN_PASSWORD="CHANGE_ME_Strong#Pass1"
# Set to "true" to also load 3+ months of clearly-marked DEMO data (never in production).
SEED_DEMO_DATA=false

# ---- File storage (expense bills, receipts) ----
# Vercel: connect a Blob store (Storage → Blob); BLOB_READ_WRITE_TOKEN is then set automatically
# and bills are stored PRIVATELY in Vercel Blob. Otherwise files go to UPLOAD_DIR on disk
# (mount a persistent, backed-up volume). Force a driver with STORAGE_DRIVER=local|vercel-blob.
# BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="./uploads"
# Max upload size in MB (default 10, or 4 on Vercel because of its 4.5 MB request limit)
# MAX_UPLOAD_MB=10

# ---- Business timezone ----
APP_TIMEZONE="Asia/Kolkata"
